@model ProPublicAPI.Models.NonProfitOrganizationDetail

<style>
    .table-wrapper {
        max-height: 500px;
        overflow-y: auto;
    }

    th, td {
        white-space: nowrap;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #343a40; /* match .table-dark */
        color: white;
        z-index: 10;
    }
</style>

@{
    ViewData["Title"] = "Organization Detail";
    var org = Model.Organization;
}
@{
    string FormatTaxPeriod(int? taxPrd)
    {
        // Convert int (e.g., 201512) to DateTime (e.g., Dec 2015)
        var taxPrdStr = taxPrd.ToString();
        if (taxPrdStr.Length == 6 &&
            int.TryParse(taxPrdStr.Substring(0, 4), out int year) &&
            int.TryParse(taxPrdStr.Substring(4, 2), out int month))
        {
            try
            {
                var date = new DateTime(year, month, 1);
                return date.ToString("MMM yyyy"); // e.g., Dec 2015
            }
            catch
            {
                return taxPrdStr; // fallback if invalid
            }
        }

        return taxPrdStr;
    }
}

<h2>@org?.Name</h2>

@if (org != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <p><strong>EIN:</strong> @org.Ein</p>
            <p><strong>Address:</strong> @org.Address, @org.City, @org.State @org.Zipcode</p>
            <p><strong>Exemption Number:</strong> @org.ExemptionNumber</p>
            <p><strong>NTEE Code:</strong> @org.NteeCode</p>
            <p><strong>Revenue:</strong> @org.RevenueAmount?.ToString("C")</p>
            <p><strong>Assets:</strong> @org.AssetAmount?.ToString("C")</p>
            <p><strong>Income:</strong> @org.IncomeAmount?.ToString("C")</p>
            @* <p><strong>Data Source:</strong> @Model.DataSource</p> *@
            <p><strong>Created At:</strong> @org.CreatedAt?.ToString("yyyy-MM-dd")</p>
            <p><strong>Updated At:</strong> @org.UpdatedAt?.ToString("yyyy-MM-dd")</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">No organization details available.</div>
}

