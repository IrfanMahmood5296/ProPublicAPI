                    <td>@FormatTaxPeriod(filing.TaxPrd)</td>
                    <td>@filing.FormtypeStr</td>
                    <td>
                        @if (!string.IsNullOrEmpty(filing.PdfUrl))
                        {
                            <a href="@filing.PdfUrl" target="_blank">View PDF</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No filings without data available.</p>
}
